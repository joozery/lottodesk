# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
PORT=4000
# ใส่ user/password ใน URI; ถ้ารหัสผ่านมีอักขระพิเศษ (@ : / ?) ต้อง URL-encode
MONGODB_URI=mongodb://USER:PASSWORD@72.60.195.203:27017/?authSource=admin
MONGODB_DB=lottodesk
# สุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร เช่น: openssl rand -base64 48
JWT_SECRET=
# origin ของหน้าเว็บ (ใส่หลายค่าคั่นด้วย comma ได้)
CORS_ORIGIN=http://localhost:3001
# true เมื่อใช้ผ่าน HTTPS (production)
COOKIE_SECURE=false
